MINIO_SECRET_KEY=laporkuy123
JEV_BASE_URL=https://openrouter.ai/api/v1
JEV_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# Ambang routing Jev (terkalibrasi: lihat catatan di jev-routing.ts).
# JEV_REVIEW_NOUL=0.55         # kategori_cocok (Noul)
# JEV_DINAS_MIN_TOP=0.5        # probabilitas dinas tertinggi Jev
# JEV_DINAS_MIN_MAPPED=0.3     # probabilitas dinas berwenang (mapping)
# Redis dan JEV/AI sudah terhubung melalui queue worker (mode non-demo).
# Queue Redis memakai Bun.RedisClient bawaan; worker jalan di proses yang sama.
REDIS_URL=redis://localhost:6379
