+import { useState } from "react";
+import { api, loginURL } from "../lib/api.js";
+import { Notice, PrivateReport } from "../components/ReportWidgets.jsx";
+export default function TrackReport() {
+  const [ticket,setTicket] = useState(new URLSearchParams(location.search).get("tiket") || "");
+  const [result,setResult] = useState(null);
+  const [error,setError] = useState("");
+  const [login,setLogin] = useState(false);
+  const [busy,setBusy] = useState(false);
+  async function track(event) {
+    event.preventDefault(); setBusy(true); setResult(null); setError(""); setLogin(false);
+    const normalized = ticket.trim().toUpperCase();
+    history.replaceState(null,"",`/lacak?tiket=${encodeURIComponent(normalized)}`);
+    try { setResult(await api(`/track/${encodeURIComponent(normalized)}`)); }
+    catch(e) { setError(e.message); setLogin(e.status === 401); }
+    finally { setBusy(false); }
+  }
+  return <section className="lk-page container"><p className="lk-kicker">PANTAU TINDAK LANJUT</p><h1>Lacak laporanmu</h1><p className="lk-intro">Masukkan nomor tiket dari riwayat laporan. Masuk dengan akun pelapor untuk melihat detail dan tanggapan pemerintah.</p>
+    <form className="lk-track-form" onSubmit={track}><label htmlFor="ticket">Nomor tiket</label><div><input id="ticket" name="ticket" value={ticket} required maxLength={64} placeholder="Contoh: LPK-DEMO0001" onChange={e => setTicket(e.target.value)} /><button className="btn btn--primary" disabled={busy}>{busy ? "Mencari..." : "Lacak laporan"}</button></div></form>
+    {error && <Notice error>{error} {login && <a className="lk-text-link" href={loginURL()}>Masuk ke akun →</a>}</Notice>}
+    {result && <article className="lk-panel"><PrivateReport report={result.report} history={result.history} /></article>}
+  </section>;
+}
